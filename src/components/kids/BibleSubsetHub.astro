---
// v1.E — one Bible sub-hub (verses, preschool, characters, books of the Bible):
// cards for every page in the collection, a print-all PDF, short guidance, FAQ.
import { FileDown } from "lucide-react";
import SiteLayout from "../../layouts/SiteLayout.astro";
import ShareButton from "./ShareButton.astro";
import { collections, coloringPagePath, printableAlt } from "../../config/site";

interface Props {
  id: string; // collection id in src/config/site.ts
  metaTitle: string;
  description: string;
  h1: string;
  crumb: string;
  intro: string;
  sections: { heading: string; body: string }[];
  faq: { q: string; a: string }[];
}

const p = Astro.props;
const c = collections.find((x) => x.id === p.id);
if (!c?.hub || !c.set) throw new Error(`collection ${p.id} needs hub + set`);
const site = "https://lamill.store";
const url = `${site}${c.hub}`;
const setPdf = `/printables/${c.set}.pdf`;
const others = collections.filter((x) => x.hub && x.id !== c.id);
const ld = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Kids’ Activities", item: `${site}/kids/` },
      { "@type": "ListItem", position: 2, name: "Bible Coloring Pages", item: `${site}/kids/bible-coloring-pages/` },
      { "@type": "ListItem", position: 3, name: p.crumb, item: url },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: p.h1,
    url,
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: c.printables.length,
      itemListElement: c.printables.map((x, i) => ({ "@type": "ListItem", position: i + 1, name: x.title, url: `${site}${coloringPagePath(x)}` })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: p.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---
<SiteLayout title={p.metaTitle} description={p.description} ogTitle={p.h1} ogDescription={p.description}>
  <script slot="extra-head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="kids mx-auto max-w-6xl px-4 pt-8">
    <nav aria-label="Breadcrumb" class="text-sm text-muted-foreground">
      <a href="/kids/" class="hover:text-primary">Kids’ Activities</a> <span aria-hidden="true">›</span>
      <a href="/kids/bible-coloring-pages/" class="hover:text-primary">Bible Coloring Pages</a> <span aria-hidden="true">›</span>
      <span aria-current="page">{p.crumb}</span>
    </nav>

    <header class="mt-4 max-w-3xl">
      <h1 class="font-kids text-4xl font-bold text-primary sm:text-5xl">{p.h1}</h1>
      <p class="mt-4 text-lg">{p.intro}</p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <a href={setPdf} download class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 text-lg font-semibold text-primary-foreground hover:bg-primary/90">
          <FileDown className="h-5 w-5" aria-hidden="true" /> Download all {c.printables.length} (PDF)
        </a>
        <ShareButton title={p.h1} pdf={setPdf} />
      </div>
    </header>

    <ul class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3">
      {c.printables.map((x) => (
        <li class="overflow-hidden rounded-3xl border-2 border-border bg-card hover:border-primary">
          <a href={coloringPagePath(x)} class="block p-3">
            <img src={x.preview} alt={printableAlt(x)} width={x.width} height={x.height} loading="lazy" class="mx-auto h-auto w-full max-w-[16rem]" />
            <span class="mt-2 block font-kids text-lg font-semibold leading-tight text-primary">{x.title.replace(/ Coloring Page$/, "")}</span>
            <span class="block text-sm text-muted-foreground">{x.passage}</span>
          </a>
          <a href={x.pdf} download class="mx-3 mb-3 inline-flex items-center gap-1 text-sm font-semibold text-primary underline">PDF</a>
        </li>
      ))}
    </ul>

    {p.sections.map((s) => (
      <section class="mt-12 max-w-3xl">
        <h2 class="font-kids text-3xl font-bold text-primary">{s.heading}</h2>
        <p class="mt-3">{s.body}</p>
      </section>
    ))}

    <section class="mt-12 max-w-3xl">
      <h2 class="font-kids text-3xl font-bold text-primary">Questions parents ask</h2>
      <dl class="mt-4 space-y-5">
        {p.faq.map((f) => (
          <div>
            <dt class="font-semibold">{f.q}</dt>
            <dd class="mt-1 text-muted-foreground">{f.a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="mt-12 max-w-3xl">
      <h2 class="font-kids text-2xl font-bold text-primary">More Bible coloring pages</h2>
      <ul class="mt-3 space-y-1">
        {others.map((o) => (
          <li><a href={o.hub} class="font-semibold text-primary underline">{o.title} coloring pages</a> <span class="text-muted-foreground">— {o.blurb}</span></li>
        ))}
        <li><a href="/kids/bible-coloring-pages/" class="font-semibold text-primary underline">Bible story coloring pages</a> <span class="text-muted-foreground">— Creation to Easter morning, in Bible order.</span></li>
      </ul>
    </section>
  </div>
</SiteLayout>
