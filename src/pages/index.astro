---
// src/pages/index.astro
import { Download, ArrowRight } from "lucide-react";
import SiteLayout from "../layouts/SiteLayout.astro";
import { collections, featuredPrintable, storefronts } from "../config/site";
import { href } from "../lib/paths";

const site = "https://lamill.store";
const title = "LaMill Store — Free Bible activities for kids";
const description = "Free printable Bible coloring pages for kids from LaMill. Our Etsy shop and physical goods store are coming soon.";
const ogTitle = "LaMill Store";
const ogDescription = "Free printable Bible coloring pages for kids from LaMill.";
// Canonical MUST match the served URL incl. trailing slash (trailingSlash:
// 'always' in astro.config.mjs). A no-slash canonical 308-redirects and
// breaks indexing (CHECK_161).
const canonical = `${site}/`;

const col = collections.find((c) => c.id === featuredPrintable.collectionId);
const p = col?.printables.find((x) => x.id === featuredPrintable.printableId);
---
<SiteLayout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="lamill.store" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />

    <!-- JSON-LD structured data: Organization + WebSite -->
    <script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://lamill.store/#organization",
      "name": "LaMill Store",
      "url": "https://lamill.store/"
    },
    {
      "@type": "WebSite",
      "@id": "https://lamill.store/#website",
      "url": "https://lamill.store/",
      "name": "LaMill Store",
      "publisher": { "@id": "https://lamill.store/#organization" }
    }
  ]
}
    </script>
  </Fragment>

  <section class="mx-auto max-w-6xl px-4 pt-12 pb-8 text-center sm:pt-16">
    <p class="text-sm font-semibold uppercase tracking-widest text-brand">Welcome to LaMill</p>
    <h1 class="mx-auto mt-3 max-w-2xl font-display text-4xl font-semibold text-primary sm:text-5xl">
      One home for everything we make.
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-muted-foreground">
      Start with free Bible coloring pages for kids. Our Etsy shop and physical goods store are coming soon.
    </p>
  </section>

  <section class="mx-auto grid max-w-6xl gap-6 px-4 md:grid-cols-3">
    {storefronts.map((s, i) => (
      <article class="flex flex-col overflow-hidden rounded-2xl border border-border bg-card shadow-card">
        {s.image ? (
          <img src={s.image} alt="" width={850} height={1100} loading={i === 0 ? "eager" : "lazy"} class="aspect-[4/3] w-full bg-white object-contain p-4" />
        ) : (
          <div class="flex aspect-[4/3] w-full items-center justify-center bg-secondary">
            <span class="rounded-full bg-card px-4 py-2 text-sm font-semibold text-primary">Coming soon</span>
          </div>
        )}
        <div class="flex flex-1 flex-col p-6">
          <h2 class="font-display text-2xl font-semibold text-primary">{s.title}</h2>
          <p class="mt-2 flex-1 text-muted-foreground">{s.description}</p>
          {s.status === "live" ? (
            <a href={href(s.path)} class="mt-5 inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-5 py-3 font-medium text-primary-foreground hover:bg-primary/90">
              {s.cta} <ArrowRight className="h-4 w-4" />
            </a>
          ) : (
            <span class="mt-5 inline-flex items-center justify-center rounded-lg bg-muted px-5 py-3 font-medium text-muted-foreground">{s.cta}</span>
          )}
        </div>
      </article>
    ))}
  </section>

  {p?.file && (
    <section class="mx-auto mt-16 max-w-6xl px-4">
      <div class="grid items-center gap-6 rounded-2xl bg-secondary p-6 sm:grid-cols-[200px_1fr] sm:p-8">
        <img src={p.preview} alt={`${p.title} preview`} class="mx-auto w-40 rounded-lg border border-border bg-card sm:w-full" />
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-brand">Free printable</p>
          <h2 class="mt-2 font-display text-3xl font-semibold text-primary">{p.title}</h2>
          <p class="mt-2 text-muted-foreground">Print at home and color. No sign-up needed.</p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a href={p.file} download class="inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-3 font-medium text-primary-foreground hover:bg-primary/90">
              <Download className="h-4 w-4" /> Download free
            </a>
            <a href="/kids/" class="inline-flex items-center rounded-lg border border-primary px-5 py-3 font-medium text-primary hover:bg-card">
              More printables
            </a>
          </div>
        </div>
      </div>
    </section>
  )}
</SiteLayout>
