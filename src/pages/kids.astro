---
import { Sparkles } from "lucide-react";
import SiteLayout from "../layouts/SiteLayout.astro";
import { KidsCollections } from "../components/kids/KidsCollections";
import { collections } from "../config/site";
import { themeCollections, hubPath, designFiles, byId, featuredThemeId, DESIGN_W, DESIGN_H } from "../config/coloring";

const featured = byId(featuredThemeId) ?? themeCollections[0];
const hero = featured.designs[0];
---
<SiteLayout
  title="Kids’ Activities — Free printables | LaMill Store"
  description="Free printable coloring pages for kids: Bible stories, Thanksgiving, Christmas, winter, dogs, dragons and monster trucks. Print at home, no sign-up needed."
  ogTitle="Free Kids’ Printables from LaMill"
  ogDescription="Free printable coloring pages for kids: Bible stories, Thanksgiving, Christmas, winter, dogs, dragons and monster trucks."
>
  <div class="kids">
    <section class="bg-kids-sky">
      <div class="mx-auto grid max-w-6xl items-center gap-8 px-4 py-10 md:grid-cols-2">
        <div>
          <h1 class="font-kids text-4xl font-bold text-primary sm:text-5xl">Kids’ Activities</h1>
          <p class="mt-3 text-lg text-foreground">Free coloring pages for kids, from Bible stories to dragons and monster trucks. Just tap download and print! Or browse <a href="/kids/bible-coloring-pages/" class="font-semibold text-primary underline">all Bible coloring pages by story</a>.</p>
          <nav class="mt-5 flex flex-wrap gap-2" aria-label="Collections">
            {collections.map((c) => (
              <a href={`#${c.id}`} class="inline-flex items-center gap-2 rounded-full bg-card px-4 py-2 font-kids font-semibold text-primary shadow-card">
                <c.icon className="h-4 w-4" aria-hidden="true" /> {c.title}
              </a>
            ))}
            <a href="#themes" class="inline-flex items-center gap-2 rounded-full bg-card px-4 py-2 font-kids font-semibold text-primary shadow-card">By theme</a>
          </nav>
        </div>
        <a href={hubPath(featured)} class="mx-auto block">
          <img src={designFiles(hero).preview} alt={`${featured.h1}: ${hero.alt}`} width={DESIGN_W} height={DESIGN_H} class="mx-auto max-h-96 w-auto rounded-3xl bg-card p-4 shadow-card" />
        </a>
      </div>
    </section>

    <section class="mx-auto mt-10 max-w-6xl px-4">
      <div class="flex flex-col gap-3 rounded-3xl border-2 border-dashed border-brand bg-card p-6 sm:flex-row sm:items-center">
        <Sparkles className="h-8 w-8 shrink-0 text-brand" />
        <div class="flex-1">
          <h2 class="font-kids text-2xl font-bold text-primary">Put your child in the story</h2>
          <p class="text-muted-foreground">Personalized pages with your child’s name and picture.</p>
        </div>
        <span class="self-start rounded-full bg-secondary px-3 py-1 text-sm font-semibold text-primary sm:self-center">Coming soon</span>
      </div>
    </section>

    <section id="themes" class="mx-auto mt-12 max-w-6xl scroll-mt-24 px-4">
      <h2 class="font-kids text-3xl font-bold text-primary">Coloring pages by theme</h2>
      <p class="mt-1 text-muted-foreground">Seven free pages in each set, from easy to detailed, with one PDF to print them all.</p>
      <ul class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
        {themeCollections.map((c) => (
          <li class="overflow-hidden rounded-3xl border-2 border-border bg-card hover:border-primary">
            <a href={hubPath(c)} class="block p-3">
              <img src={designFiles(c.designs[1] ?? c.designs[0]).preview} alt={`${c.h1}: ${(c.designs[1] ?? c.designs[0]).alt}`} width={DESIGN_W} height={DESIGN_H} loading="lazy" class="mx-auto h-auto w-full" />
              <span class="mt-2 block font-kids text-lg font-semibold leading-tight text-primary">{c.h1}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <KidsCollections client:load />
  </div>
</SiteLayout>
