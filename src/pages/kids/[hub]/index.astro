---
// v2.B — theme coloring hub: one indexable page per search intent.
import { FileDown } from "lucide-react";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { themeCollections, designPath, designFiles, hubPath, setPdf, byId, LEVELS, DESIGN_W, DESIGN_H, type ThemeCollection, type Level } from "../../../config/coloring";

export function getStaticPaths() {
  return themeCollections.map((c) => ({ params: { hub: c.hub }, props: { c } }));
}

const { c } = Astro.props as { c: ThemeCollection };
const site = "https://lamill.store";
const url = `${site}${hubPath(c)}`;
const levels = (["easy", "medium", "detailed"] as Level[])
  .map((l) => ({ l, designs: c.designs.filter((d) => d.level === l) }))
  .filter((g) => g.designs.length > 0);
const related = c.related.map(byId).filter(Boolean) as ThemeCollection[];

const ld = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Kids’ Activities", item: `${site}/kids/` },
      { "@type": "ListItem", position: 2, name: c.h1, item: url },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: c.h1,
    url,
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: c.designs.length,
      itemListElement: c.designs.map((d, i) => ({ "@type": "ListItem", position: i + 1, name: d.title, url: `${site}${designPath(c, d)}` })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: c.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---
<SiteLayout title={c.metaTitle} description={c.description} ogTitle={c.h1} ogDescription={c.description}>
  <script slot="extra-head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="kids mx-auto max-w-6xl px-4 pt-8">
    <nav aria-label="Breadcrumb" class="text-sm text-muted-foreground">
      <a href="/kids/" class="hover:text-primary">Kids’ Activities</a> <span aria-hidden="true">›</span>
      <span aria-current="page">{c.h1}</span>
    </nav>

    <header class="mt-4 max-w-3xl">
      <h1 class="font-kids text-4xl font-bold text-primary sm:text-5xl">{c.h1}</h1>
      <p class="mt-4 text-lg">{c.intro}</p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <a href={setPdf(c)} download class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 text-lg font-semibold text-primary-foreground hover:bg-primary/90">
          <FileDown className="h-5 w-5" aria-hidden="true" /> Download all {c.designs.length} (PDF)
        </a>
        <nav class="flex flex-wrap gap-2" aria-label="Levels">
          {levels.map((g) => (
            <a href={`#${g.l}`} class="rounded-full bg-card px-4 py-2 font-kids font-semibold text-primary shadow-card">{LEVELS[g.l].label}</a>
          ))}
        </nav>
      </div>
    </header>

    {levels.map((g) => (
      <section id={g.l} class="mt-12 scroll-mt-20">
        <h2 class="font-kids text-3xl font-bold text-primary">{LEVELS[g.l].label} <span class="text-xl text-muted-foreground">· {LEVELS[g.l].ages}</span></h2>
        <ul class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
          {g.designs.map((d) => (
            <li class="overflow-hidden rounded-3xl border-2 border-border bg-card hover:border-primary">
              <a href={designPath(c, d)} class="block p-3">
                <img src={designFiles(d).preview} alt={`Coloring page: ${d.alt}`} width={DESIGN_W} height={DESIGN_H} loading="lazy" class="mx-auto h-auto w-full" />
                <span class="mt-2 block font-kids text-lg font-semibold leading-tight text-primary">{d.title}</span>
              </a>
              <a href={designFiles(d).pdf} download class="mx-3 mb-3 inline-flex items-center gap-1 text-sm font-semibold text-primary underline">PDF</a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {c.sections.map((s) => (
      <section class="mt-12 max-w-3xl">
        <h2 class="font-kids text-3xl font-bold text-primary">{s.heading}</h2>
        <p class="mt-3">{s.body}</p>
      </section>
    ))}

    <section class="mt-12 max-w-3xl">
      <h2 class="font-kids text-3xl font-bold text-primary">Printing tips</h2>
      <p class="mt-3">
        Open any picture and tap <strong>Print</strong>: only the picture prints, sized to one portrait page with a
        white margin, on US Letter or A4. If your phone or browser won’t cooperate, use the PDF instead; it is
        already laid out as a single US Letter page of black lines on white.
      </p>
    </section>

    <section class="mt-12 max-w-3xl">
      <h2 class="font-kids text-3xl font-bold text-primary">Questions parents ask</h2>
      <dl class="mt-4 space-y-5">
        {c.faq.map((f) => (
          <div>
            <dt class="font-semibold">{f.q}</dt>
            <dd class="mt-1 text-muted-foreground">{f.a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="mt-12">
      <h2 class="font-kids text-2xl font-bold text-primary">More coloring pages</h2>
      <ul class="mt-3 flex flex-wrap gap-3">
        {related.map((r) => (
          <li><a href={hubPath(r)} class="inline-block rounded-full border-2 border-border bg-card px-4 py-2 font-semibold text-primary hover:border-primary">{r.h1}</a></li>
        ))}
        {(c.extraLinks ?? []).map((x) => (
          <li><a href={x.href} class="inline-block rounded-full border-2 border-border bg-card px-4 py-2 font-semibold text-primary hover:border-primary">{x.label}</a> <span class="text-sm text-muted-foreground">({x.note})</span></li>
        ))}
        <li><a href="/kids/" class="inline-block rounded-full border-2 border-border bg-card px-4 py-2 font-semibold text-primary hover:border-primary">All kids’ activities</a></li>
      </ul>
    </section>
  </div>
</SiteLayout>
