---
import SiteLayout from "../layouts/SiteLayout.astro";
import { products, type Product } from "../config/site";

const label: Record<Product["status"], string> = {
  available: "In stock",
  "sold-out": "Sold out",
  "coming-soon": "Coming soon",
};
---
<SiteLayout
  title="Physical Goods | LaMill Store"
  description="Printed activity books and party kits made by LaMill."
  ogTitle="LaMill Physical Goods"
  ogDescription="Activity books and party kits, shipped directly from LaMill."
>
  <section class="mx-auto max-w-6xl px-4 pt-12">
    <h1 class="font-display text-4xl font-semibold text-primary">Physical Goods</h1>
    <p class="mt-2 max-w-xl text-muted-foreground">Things we make and ship ourselves. Online checkout is on the way.</p>
  </section>
  <div class="mx-auto mt-8 grid max-w-6xl gap-6 px-4 sm:grid-cols-2 lg:grid-cols-3">
    {products.map((p) => (
      <article class="overflow-hidden rounded-2xl border border-border bg-card shadow-card">
        <div class="relative">
          <img src={p.image} alt={p.name} loading="lazy" width={1024} height={768} class="aspect-[4/3] w-full object-cover" />
          <span class="absolute left-3 top-3 rounded-full bg-card px-3 py-1 text-xs font-semibold text-primary">{label[p.status]}</span>
        </div>
        <div class="p-5">
          <div class="flex items-baseline justify-between gap-3">
            <h2 class="font-display text-xl font-semibold text-primary">{p.name}</h2>
            {p.price != null && <span class="font-semibold">${p.price.toFixed(2)}</span>}
          </div>
          <p class="mt-2 text-sm text-muted-foreground">{p.description}</p>
          <button disabled class="mt-4 w-full rounded-lg bg-muted px-4 py-3 font-medium text-muted-foreground">
            {p.status === "available" ? "Checkout coming soon" : label[p.status]}
          </button>
        </div>
      </article>
    ))}
  </div>
</SiteLayout>
